<!DOCTYPE html>
<html lang="ar">
<head>
    <meta charset="UTF-8">
    <title>مستخرج الأرقام الذكي</title>
</head>
<body style="font-family: sans-serif; text-align: center; padding: 20px; background-color: #f9f9f9;">

    <h2>مستخرج الأرقام السريع (مخصص للنصوص الضخمة)</h2>
    
    <textarea id="inputText" placeholder="أصق النص أو الروابط الضخمة هنا..." style="width: 90%; height: 180px; padding: 10px; border-radius: 8px; border: 1px solid #ccc; font-size: 14px;"></textarea>
    <br><br>
    
    <button onclick="extractNumbers()" style="padding: 12px 25px; font-size: 16px; cursor: pointer; background-color: #007bff; color: white; border: none; border-radius: 5px;">استخرج الأرقام</button>
    <button onclick="copyToClipboard()" id="copyBtn" style="padding: 12px 25px; font-size: 16px; cursor: pointer; background-color: #28a745; color: white; border: none; border-radius: 5px; display: none; margin-right: 10px;">نسخ الكل</button>

    <div style="margin-top: 20px; text-align: left; width: 90%; margin-left: auto; margin-right: auto;">
        <label style="font-weight: bold; display: block; text-align: center; margin-bottom: 8px;">النتيجة (من اليسار إلى اليمين):</label>
        <textarea id="outputText" readonly dir="ltr" style="width: 100%; height: 150px; padding: 10px; border-radius: 8px; border: 1px solid #28a745; font-size: 16px; direction: ltr; text-align: left; background-color: #fff;"></textarea>
    </div>

    <script>
        function extractNumbers() {
            const text = document.getElementById("inputText").value;
            
            // خوارزمية ذكية تستخرج الأرقام المسبوقة بـ _ مباشرة (مثل PEG_55)
            const matches = text.match(/(?<=_)\d+/g);
            
            const outputArea = document.getElementById("outputText");
            const copyBtn = document.getElementById("copyBtn");

            if (matches && matches.length > 0) {
                outputArea.value = matches.join(", ");
                copyBtn.style.display = "inline-block";
            } else {
                outputArea.value = "لم يتم العثور على أرقام مطلوبة.";
                copyBtn.style.display = "none";
            }
        }

        function copyToClipboard() {
            const outputArea = document.getElementById("outputText");
            outputArea.select();
            document.execCommand("copy");
            
            const btn = document.getElementById("copyBtn");
            btn.innerText = "تم النسخ!";
            setTimeout(() => { btn.innerText = "نسخ الكل"; }, 2000);
        }
    </script>

</body>
</html>
